      if (merge) { ship(); wait = 1950; }
      else if (queue.length) { advance(); wait = 1350; }
      if (queue.length < 2 || (queue.length < 3 && Math.random() < 0.4)) setTimeout(function () { if (running) add(); }, 650);
      timer = setTimeout(step, wait);
    }
    function instant() {
      if (merge) { merge.el.remove(); merge.ball.remove(); merge = null; shipped++; minutes += 3; }
      add();
      merge = queue.shift(); place(merge, MERGE_X, 0); merge.el.style.zIndex = 10;
      merge.el.querySelector('.oc-t-paper').classList.add('is-stamped');
