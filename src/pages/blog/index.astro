---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" });
---
<Base title="Writing" description="Notes by Kai Liao on building AI agents, products and data work.">
  <main class="col page">
    <h1 class="section-title">Writing</h1>
    <p class="lede">Notes on building agents, products and the occasional detour. Also on <a class="ink-link" href="/rss.xml">RSS</a>.</p>
    <ul class="post-list">
      {posts.map((p) => (
        <li><a class="quiet-link" href={`/blog/${p.id}`}><span>{p.data.title}</span><time class="mono" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></a></li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .page { padding-top: 40px; min-height: 50vh; }
  .lede { margin: 0 0 28px; }
</style>
