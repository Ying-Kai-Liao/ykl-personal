---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const SITE = "Kai Liao";
const {
  title,
  description = "Kai Liao is an agent engineer in Sydney who builds AI agents that do real work and know when to stop and ask. Open to work.",
  image = "/images/meta/og-image.png",
  type = "website",
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : `${SITE} · agent engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const section = path === "/" ? "home" : path.startsWith("/projects") ? "projects" : path.startsWith("/blog") ? "writing" : "";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/images/meta/favicon.png">
  <link rel="alternate" type="application/rss+xml" title="Kai Liao: writing" href="/rss.xml">
  <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Geist+Mono:wght@400&display=swap">
  <slot name="head" />
</head>
<body>
  <nav class="nav" aria-label="Site">
    <div class="pill">
      <a href="/" aria-label="Home" title="Home" aria-current={section === "home" ? "page" : undefined}><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.3 2.6a1.2 1.2 0 0 1 1.4 0l8 6.1c.3.2.5.6.5 1V20a1.5 1.5 0 0 1-1.5 1.5H15V15a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v6.5H4.3A1.5 1.5 0 0 1 2.8 20V9.7c0-.4.2-.8.5-1l8-6.1Z"/></svg></a>
      <a href="/projects" aria-label="Projects" title="Projects" aria-current={section === "projects" ? "page" : undefined}><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9 3.5h6A1.5 1.5 0 0 1 16.5 5v1.5H20A1.5 1.5 0 0 1 21.5 8v3.2H2.5V8A1.5 1.5 0 0 1 4 6.5h3.5V5A1.5 1.5 0 0 1 9 3.5Zm0 1.6v1.4h6V5.1H9ZM2.5 12.8h8v1.4h3v-1.4h8V19A1.5 1.5 0 0 1 20 20.5H4A1.5 1.5 0 0 1 2.5 19v-6.2Z"/></svg></a>
      <a href="/blog" aria-label="Writing" title="Writing" aria-current={section === "writing" ? "page" : undefined}><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.9 2.9a2.1 2.1 0 0 1 3 0l1.2 1.2a2.1 2.1 0 0 1 0 3L9.6 18.6a2 2 0 0 1-.9.5l-4.6 1.3a.8.8 0 0 1-1-1l1.3-4.6c.1-.3.3-.6.5-.9L16.9 2.9Z"/><path fill="currentColor" d="M12.5 19.5h8a1 1 0 1 1 0 2h-8a1 1 0 1 1 0-2Z" opacity=".55"/></svg></a>
    </div>
  </nav>

  <slot />
</body>
</html>
