.obj-crew .oc-rivet.r1 { left: 3.3cqw; top: 3.3cqw; } .obj-crew .oc-rivet.r2 { right: 3.3cqw; top: 3.3cqw; }
.obj-crew .oc-rivet.r3 { left: 3.3cqw; bottom: 3.3cqw; } .obj-crew .oc-rivet.r4 { right: 3.3cqw; bottom: 3.3cqw; }
