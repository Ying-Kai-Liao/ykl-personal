---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import HeroSwitcher from "../components/HeroSwitcher.astro";
import NameCard from "../components/NameCard.astro";
import Carousel from "../components/Carousel.astro";
import SocialLinks from "../components/SocialLinks.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("en-AU", { month: "short", year: "numeric" });
---
<Base>
  <HeroSwitcher />

  <main>
    <div class="col intro">
      <p>Hey,</p>
      <p>I'm <NameCard />, an <span class="k">agent engineer</span> in Sydney.</p>
      <p>I build AI agents that do real work and know when to <span class="k">stop and ask</span>, and I study how to make them reliable.</p>
      <p>Reach me at <a class="ink-link" href="mailto:lykevin890919@gmail.com">lykevin890919@gmail.com</a>. I'm open to work.</p>
      <SocialLinks />
    </div>

    <Carousel />

    {posts.length > 0 && (
      <section class="col writing" aria-labelledby="writing-title">
        <h2 class="section-title" id="writing-title">Writing</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li><a class="quiet-link" href={`/blog/${p.id}`}><span>{p.data.title}</span><time class="mono" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></a></li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>

<style>
  .intro { padding-top: 32px; }
  @media (max-height: 760px) and (min-width: 600px) { .intro { padding-top: 20px; } }
  .intro p { margin: 0 0 18px; }
  .writing { margin-top: 72px; }
</style>
<style is:global>
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-list a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 6px 0; }
  .post-list time { flex: none; }
</style>
