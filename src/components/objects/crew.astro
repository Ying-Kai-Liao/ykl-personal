    }
    function start() { if (running) return; running = true; root.classList.remove('is-paused'); timer = setTimeout(step, 700); }
    function stop() { running = false; clearTimeout(timer); root.classList.add('is-paused'); }
    function update() { if (visible && !document.hidden && !reduce.matches) start(); else stop(); }

    // initial state: three waiting, one at the merge box
    root.classList.add('is-init');
    for (var i = 0; i < 4; i++) { var t = make(); queue.push(t); }
    layout();
    advance();
    queue.forEach(function (t) { t.el.firstChild.classList.remove('is-swing'); });
    if (reduce.matches) { merge.el.querySelector('.oc-t-paper').classList.add('is-stamped'); lamp.classList.add('is-lit'); }
    renderCount(false); renderClock();
    void plate.offsetWidth;
    requestAnimationFrame(function () { root.classList.remove('is-init'); });

    root.addEventListener('click', function () { if (reduce.matches) instant(); else add(); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; update(); }, { threshold: 0.15 }).observe(root);
    } else { visible = true; }
    document.addEventListener('visibilitychange', update);
    if (reduce.addEventListener) reduce.addEventListener('change', update);
    update();
  }
})();
