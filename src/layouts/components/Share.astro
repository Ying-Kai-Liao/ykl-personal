---
import config from "@/config/config.json";
import CopyLinkButton from "@/components/CopyLinkButton";
import { IoLogoFacebook, IoLogoLinkedin } from "react-icons/io5";
import { FaXTwitter, FaThreads } from "react-icons/fa6";

const { base_url }: { base_url: string } = config.site;
const {
  title,
  description,
  slug,
  className,
}: { title?: string; description?: string; slug?: string; className?: string } =
  Astro.props;

const fullUrl = `${base_url}/${slug}`;
const encodedTitle = encodeURIComponent(title || "");
const encodedUrl = encodeURIComponent(fullUrl);
---

<ul class={`${className}`}>
  <li class="inline-block">
    <a
      aria-label="share on X"
      href={`https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <FaXTwitter />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="share on Threads"
      href={`https://www.threads.net/intent/post?text=${encodeURIComponent((title || "") + " " + fullUrl)}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <FaThreads />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="share on Facebook"
      href={`https://facebook.com/sharer/sharer.php?u=${encodedUrl}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoFacebook />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="share on LinkedIn"
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}&summary=${encodeURIComponent(description || "")}&source=${encodeURIComponent(base_url)}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoLinkedin />
    </a>
  </li>
  <li class="inline-block">
    <CopyLinkButton client:load />
  </li>
</ul>
