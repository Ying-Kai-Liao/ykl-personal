@keyframes obj-crew-swing { 0% { transform: rotate(calc(var(--tilt) + var(--sw) * 4.5deg)); } 28% { transform: rotate(calc(var(--tilt) - var(--sw) * 2.4deg)); } 54% { transform: rotate(calc(var(--tilt) + var(--sw) * 1.1deg)); } 78% { transform: rotate(calc(var(--tilt) - var(--sw) * .4deg)); } 100% { transform: rotate(var(--tilt)); } }
.obj-crew .oc-t-paper { position: absolute; inset: 0; overflow: hidden; padding: 4.2cqw 1.8cqw 0; border-radius: .4cqw .4cqw .9cqw .7cqw; font-family: var(--f-mono); color: #3a352c;
