---
import { fetchThreadsPosts } from "@/lib/threads";
import type { ThreadsPost } from "@/lib/threads";

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
const posts: ThreadsPost[] = await fetchThreadsPosts(limit);

const THREADS_PROFILE = "https://www.threads.net/@yinn__nkai";

function timeAgo(timestamp: string): string {
  const now = new Date();
  const then = new Date(timestamp);
  const diff = now.getTime() - then.getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d`;
  return then.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}
---

{
  posts.length > 0 ? (
    <section class="section-sm">
      <div class="container">
        <div class="mb-8 flex items-center justify-center gap-3 animate-fade-in-up">
          <svg class="h-6 w-6 text-text-dark dark:text-darkmode-text-dark" viewBox="0 0 192 192" fill="currentColor">
            <path d="M141.537 88.988a66.667 66.667 0 0 0-2.518-1.143c-1.482-27.307-16.403-42.94-41.457-43.1h-.34c-14.986 0-27.449 6.396-35.12 18.036l13.779 9.452c5.73-8.695 14.724-10.548 21.348-10.548h.229c8.249.053 14.474 2.452 18.503 7.129 2.932 3.405 4.893 8.111 5.864 14.05-7.314-1.243-15.224-1.626-23.68-1.14-23.82 1.371-39.134 15.24-38.142 34.573.504 9.789 5.27 18.206 13.414 23.694 6.878 4.632 15.737 6.975 24.958 6.598 12.142-.496 21.668-5.194 28.318-13.967 5.055-6.668 8.208-15.2 9.537-25.932 5.716 3.454 9.953 8.038 12.348 13.624 4.07 9.49 4.311 25.076-3.394 32.782-7.085 7.085-15.61 10.151-31.089 10.279-17.171-.142-30.166-5.636-38.643-16.334-7.884-9.952-12.03-24.12-12.322-42.089.292-17.97 4.438-32.138 12.322-42.09 8.477-10.697 21.472-16.191 38.643-16.333 17.287.144 30.472 5.703 39.169 16.518 4.213 5.238 7.385 11.836 9.477 19.541l14.687-3.916c-2.593-9.63-6.646-18.024-12.168-24.891C152.878 17.07 136.258 10.143 115.86 10l-.367-.001c-20.283.142-36.747 7.044-48.916 20.506C56.95 41.667 51.822 58.55 51.494 79.108v.253c.328 20.558 5.456 37.441 15.082 48.603 12.17 13.462 28.633 20.364 48.917 20.506l.367.001c18.962-.158 30.033-4.77 39.76-14.496 11.857-11.857 11.428-33.353 5.734-46.638-4.072-9.501-11.81-17.16-22.678-22.39z" />
          </svg>
          <h2 class="text-center">Thoughts</h2>
        </div>
        <p class="mb-8 text-center text-text-light dark:text-darkmode-text-light animate-fade-in-up">
          What I'm sharing on Threads.
        </p>
        <div class="mx-auto max-w-[680px] space-y-4">
          {posts.map((post, index) => (
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "block rounded-2xl border border-border bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-darkmode-border dark:bg-darkmode-light",
                `animate-fade-in-up animate-delay-${Math.min((index + 1) * 100, 300)}`,
              ]}
            >
              <div class="mb-2 flex items-center gap-2">
                <span class="text-sm font-medium text-text-dark dark:text-darkmode-text-dark">
                  @yinn__nkai
                </span>
                <span class="text-sm text-text-light dark:text-darkmode-text-light">
                  &middot; {timeAgo(post.timestamp)}
                </span>
              </div>
              <p class="text-text dark:text-darkmode-text leading-relaxed whitespace-pre-line">
                {post.text?.length > 280 ? post.text.slice(0, 280) + "..." : post.text}
              </p>
              {post.media_url && post.media_type === "IMAGE" && (
                <img
                  src={post.media_url}
                  alt=""
                  class="mt-3 w-full rounded-xl object-cover"
                  loading="lazy"
                />
              )}
              {post.thumbnail_url && post.media_type === "VIDEO" && (
                <img
                  src={post.thumbnail_url}
                  alt=""
                  class="mt-3 w-full rounded-xl object-cover"
                  loading="lazy"
                />
              )}
            </a>
          ))}
        </div>
        <div class="text-center mt-6 animate-fade-in-up">
          <a
            href={THREADS_PROFILE}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-primary"
          >
            Follow on Threads
          </a>
        </div>
      </div>
    </section>
  ) : null
}
