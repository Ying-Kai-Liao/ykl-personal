      var n = queue.length, step = n > 1 ? Math.min(STEP, (FRONT_X - BACK_X) / (n - 1)) : 0;
      queue.forEach(function (t, i) {
        var x = FRONT_X - i * step;
        t.el.style.zIndex = 10 - i;
        if (t.x === null) {
          place(t, x, 6); void t.el.offsetWidth;
          t.el.classList.remove('is-new'); t.ball.classList.remove('is-new');
          place(t, x, 0); swing(t, 1, 300);
