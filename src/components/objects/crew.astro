.obj-crew .oc-crew-label { margin-left: .4cqw; font: 500 2.1cqw/1 var(--f-mono); letter-spacing: .22em; text-transform: uppercase; color: rgba(255,255,255,.28); text-shadow: 0 -.15cqw 0 rgba(0,0,0,.7); }
@keyframes obj-crew-work { 0% { opacity: .12; } 38% { opacity: .9; } 42% { opacity: .2; } 47% { opacity: .75; } 55% { opacity: .12; } 81% { opacity: .5; } 84% { opacity: .12; } }

