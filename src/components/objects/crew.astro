---
// Imported from yk-site/objects/crew by scripts/import-object.py; edit there and re-import.
---
<button class="obj-crew" type="button" aria-label="A night-shift ticket rail. Finished tasks from a crew of coding agents hang on the rail as paper tickets and slide one by one to a single merge box, where each is stamped shipped and dropped in. Tap to add a ticket.">
      <span class="oc-plate" aria-hidden="true">
        <span class="oc-rivet r1"></span><span class="oc-rivet r2"></span><span class="oc-rivet r3"></span><span class="oc-rivet r4"></span>
        <span class="oc-engrave">night shift</span>
        <span class="oc-crew"><span class="oc-led"></span><span class="oc-led"></span><span class="oc-led"></span><span class="oc-crew-label">crew</span></span>
        <span class="oc-rail"></span><span class="oc-cap l"></span><span class="oc-cap r"></span>
        <span class="oc-box"><span class="oc-slot"></span><span class="oc-lamp"></span><span class="oc-count"><span>000</span></span><span class="oc-box-label">shipped</span></span>
        <span class="oc-stamp"><span class="oc-knob"></span><span class="oc-neck"></span><span class="oc-block"></span><span class="oc-rubber"></span></span>
        <span class="oc-dial"><span class="oc-face"><span class="oc-ticks"></span><span class="oc-moon"></span><span class="oc-hand h"></span><span class="oc-hand m"></span><span class="oc-pin"></span></span><span class="oc-glass"></span></span>
      </span>
    </button>

<style is:inline>
.obj-crew { -webkit-appearance: none; appearance: none; border: 0; padding: 0; margin: 0; background: none; font: inherit; color: inherit; cursor: pointer; position: relative; display: block; width: min(252px, 78%); aspect-ratio: 100 / 96; container-type: inline-size; -webkit-tap-highlight-color: transparent; -webkit-user-select: none; user-select: none; }
