.obj-crew .oc-t-paper::after { content: ""; position: absolute; right: 0; bottom: 0; width: 4cqw; height: 3.4cqw; border-radius: 0 0 .7cqw 0; background: linear-gradient(140deg, rgba(255,255,255,0) 40%, rgba(255,255,255,.55) 70%, rgba(150,125,85,.25)); }
