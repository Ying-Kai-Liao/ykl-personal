      setTimeout(function () { root.classList.remove('is-press'); }, 330);
      setTimeout(function () {
        t.el.classList.add('is-drop'); t.ball.classList.add('is-gone'); place(t, t.x, 36);
      }, 1050);
      setTimeout(function () {
        t.el.remove(); t.ball.remove(); if (merge === t) merge = null;
        shipped++; renderCount(true); minutes += 3; renderClock();
        box.classList.remove('is-bump'); void box.offsetWidth; box.classList.add('is-bump');
      }, 1500);
      setTimeout(function () { lamp.classList.remove('is-lit'); }, 1750);
    }
    function step() {
