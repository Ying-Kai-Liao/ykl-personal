.obj-crew .oc-plate::before { content: ""; position: absolute; inset: 1.3cqw; border-radius: 5.9cqw; box-shadow: inset 0 0 0 .2cqw rgba(0,0,0,.28), 0 .2cqw 0 rgba(255,255,255,.045); pointer-events: none; }
