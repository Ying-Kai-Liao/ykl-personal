.obj-crew .oc-glass { position: absolute; inset: 1.7cqw; border-radius: 50%; background: linear-gradient(145deg, rgba(255,255,255,.24), rgba(255,255,255,0) 42%), radial-gradient(circle at 50% 120%, rgba(255,255,255,.08), transparent 60%); }

.obj-crew.is-init .oc-t, .obj-crew.is-init .oc-ball, .obj-crew.is-init .oc-hand { transition: none; }
.obj-crew.is-paused .oc-led::after { animation-play-state: paused; }
@media (prefers-reduced-motion: reduce) {
  .obj-crew .oc-t, .obj-crew .oc-ball, .obj-crew .oc-stamp, .obj-crew .oc-hand, .obj-crew .oc-lamp, .obj-crew .oc-plate { transition: none !important; }
  .obj-crew .oc-led::after { animation: none; opacity: .35; }
  .obj-crew .oc-t-swing.is-swing, .obj-crew .oc-box.is-bump { animation: none; }
}
</style>

<script is:inline>
(function () {
  var roots = document.querySelectorAll('.obj-crew');
  if (!roots.length) return;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var TASKS = ['fix login', 'add tests', 'dark mode', 'speed up', 'tidy css', 'new docs', 'search', 'fix typo', 'menu bug', 'sign-up', 'retry', 'tidy logs'];
  var W = 17, MERGE_X = 69.5, FRONT_X = 40, BACK_X = 5, STEP = 17.5, MAX = 7;
  Array.prototype.forEach.call(roots, init);

  function init(root) {
    var plate = root.querySelector('.oc-plate');
    var leds = root.querySelectorAll('.oc-led');
    var lamp = root.querySelector('.oc-lamp');
    var box = root.querySelector('.oc-box');
    var count = root.querySelector('.oc-count');
    var hH = root.querySelector('.oc-hand.h'), hM = root.querySelector('.oc-hand.m');
    if (!plate || !lamp || !box) return;
    var queue = [], merge = null, num = 16, shipped = 17, minutes = 2 * 60 + 14;
    var running = false, visible = false, timer = 0;

    function pad(n) { return String(n).padStart(3, '0'); }
    function clockText() { var h = Math.floor(minutes / 60) % 12 || 12, m = minutes % 60; return h + ':' + String(m).padStart(2, '0'); }
    function renderClock() {
      hH.style.transform = 'rotate(' + (minutes * 0.5) + 'deg)';
      hM.style.transform = 'rotate(' + (minutes * 6) + 'deg)';
    }
    function renderCount(tick) {
      count.firstChild.textContent = pad(shipped);
      if (tick && !reduce.matches) { count.classList.add('is-tick'); void count.offsetWidth; count.classList.remove('is-tick'); }
    }
    function make() {
      num++;
      var crew = 1 + Math.floor(Math.random() * 3);
      var tilt = (Math.random() * 3 - 1.5).toFixed(2);
      var w = function () { return 45 + Math.round(Math.random() * 50); };
      var el = document.createElement('span');
      el.className = 'oc-t is-new';
      el.innerHTML = '<span class="oc-t-swing" style="--tilt:' + tilt + 'deg;--sw:1"><span class="oc-t-paper">' +
        '<span class="oc-t-head"><span>#' + pad(num) + '</span><span>' + clockText() + '</span></span>' +
        '<span class="oc-t-perf"></span><span class="oc-t-title">' + TASKS[(num * 5) % TASKS.length] + '</span>' +
        '<span class="oc-t-line" style="width:' + w() + '%"></span><span class="oc-t-line" style="width:' + w() + '%"></span><span class="oc-t-line" style="width:' + w() + '%"></span>' +
        '<span class="oc-t-by">crew ' + crew + '</span><span class="oc-t-ink">shipped</span></span></span>';
      var ball = document.createElement('span');
