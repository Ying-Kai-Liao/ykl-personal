---
import Base from "../layouts/Base.astro";

const links = [
  { name: "Email", note: "lykevin890919@gmail.com", href: "mailto:lykevin890919@gmail.com" },
  { name: "LinkedIn", note: "Work and background", href: "https://www.linkedin.com/in/ying-kai-liao" },
  { name: "GitHub", note: "Open source", href: "https://github.com/Ying-Kai-Liao" },
  { name: "Writing", note: "Notes on agents and building", href: "/blog" },
  { name: "X", note: "Thoughts and updates", href: "https://x.com/YingKaiLiao1" },
  { name: "Threads", note: "Casual posts", href: "https://www.threads.com/@yinn__nkai" },
  { name: "Instagram", note: "Photos", href: "https://www.instagram.com/yinn__nkai" },
];
---
<Base title="Links" description="All of Kai Liao's links in one place.">
  <main class="col page">
    <img class="avatar" src="/images/profile/avatar-photo.jpg" alt="Kai Liao in sunglasses, with the Sydney Harbour Bridge in the background" width="96" height="96">
    <h1 class="section-title">Kai Liao</h1>
    <p class="lede">Agent engineer in Sydney.</p>
    <ul class="link-list">
      {links.map((l) => (
        <li><a href={l.href}><span class="k">{l.name}</span><span>{l.note}</span></a></li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .page { padding-top: 32px; text-align: center; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; background: #fff; }
  .page h1 { margin: 12px 0 0; }
  .lede { margin: 0 0 24px; }
  .link-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; text-align: left; }
  .link-list a { display: flex; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 14px; background: var(--card); text-decoration: none; color: var(--ink-2); transition: transform 160ms var(--ease-out), background-color 150ms ease; }
  .link-list a span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) { .link-list a:hover { background: var(--chip); } }
  .link-list a:active { transform: scale(.98); }
</style>
