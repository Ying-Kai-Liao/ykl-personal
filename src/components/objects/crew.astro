.obj-crew .oc-t-ink { position: absolute; left: 50%; top: 13cqw; padding: .6cqw 1cqw .5cqw; border: .32cqw solid currentColor; border-radius: .7cqw; color: rgba(30,128,80,.88); font: 600 2.1cqw/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; mix-blend-mode: multiply; opacity: 0; transform: translate(-50%, -50%) rotate(-11deg) scale(1.2);
  -webkit-mask-image: repeating-radial-gradient(circle at 28% 36%, #000 0 .55cqw, rgba(0,0,0,.62) .7cqw .85cqw, #000 1cqw); mask-image: repeating-radial-gradient(circle at 28% 36%, #000 0 .55cqw, rgba(0,0,0,.62) .7cqw .85cqw, #000 1cqw); }
.obj-crew .is-stamped .oc-t-ink { opacity: 1; transform: translate(-50%, -50%) rotate(-11deg) scale(1); }

.obj-crew .oc-box { position: absolute; left: 63cqw; top: 65cqw; width: 30cqw; height: 24cqw; z-index: 30; border-radius: 2cqw 2cqw 2.6cqw 2.6cqw;
