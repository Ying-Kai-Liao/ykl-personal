.obj-crew .oc-led::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 38% 32%, #fff5dc 0 12%, #ffbb55 40%, #e07a12 92%); box-shadow: 0 0 1.6cqw .3cqw rgba(255,170,60,.55); opacity: .12; animation: obj-crew-work 2.7s steps(1, end) infinite; transition: opacity .15s; }
.obj-crew .oc-led:nth-child(2)::after { animation-duration: 3.6s; animation-delay: -1.2s; }
.obj-crew .oc-led:nth-child(3)::after { animation-duration: 2.1s; animation-delay: -.5s; }
