---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import HeroSwitcher from "../components/HeroSwitcher.astro";
import NameCard from "../components/NameCard.astro";
import Carousel from "../components/Carousel.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("en-AU", { month: "short", year: "numeric" });
---
<Base>
  <HeroSwitcher />

  <main>
    <div class="col intro">
      <p>Hey,</p>
      <p>I'm <NameCard />, an <span class="k">agent engineer</span> in Sydney. I founded a startup in Taiwan, and now I'm doing a Master's in Data Science at UTS.</p>
      <p>I build AI agents that do real work and know when to <span class="k">stop and ask</span>. I shipped <a class="ink-link" href="https://www.stormai.dev">Storm</a>, a mind-map chat app with real users, and I'm building <span class="k">Behalve</span>, an AI staff member for small businesses.</p>
      <p class="k">Open to agent engineering roles, especially at early-stage teams.</p>
      <p class="links">
        <a class="quiet-link" href="mailto:lykevin890919@gmail.com">Email</a>
        <a class="quiet-link" href="https://www.linkedin.com/in/ying-kai-liao">LinkedIn</a>
        <a class="quiet-link" href="https://github.com/Ying-Kai-Liao">GitHub</a>
      </p>
    </div>

    <Carousel />

    {posts.length > 0 && (
      <section class="col writing" aria-labelledby="writing-title">
        <h2 class="section-title" id="writing-title">Writing</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li><a class="quiet-link" href={`/blog/${p.id}`}><span>{p.data.title}</span><time class="mono" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></a></li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>

<style>
  .intro { padding-top: 32px; }
  @media (max-height: 760px) and (min-width: 600px) { .intro { padding-top: 20px; } }
  .intro p { margin: 0 0 18px; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .writing { margin-top: 72px; }
</style>
<style is:global>
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-list a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 6px 0; }
  .post-list time { flex: none; }
</style>
