.obj-crew .oc-rail::after { content: ""; position: absolute; left: 3cqw; right: 3cqw; top: calc(50% - .5cqw); height: 1cqw; border-radius: 1cqw; background: linear-gradient(#202328, #4e5259); box-shadow: inset 0 .25cqw .3cqw rgba(0,0,0,.7), 0 .15cqw 0 rgba(255,255,255,.55); }
.obj-crew .oc-cap { position: absolute; top: 24.8cqw; width: 4.6cqw; height: 8cqw; border-radius: 1.2cqw; z-index: 21; background: linear-gradient(90deg, #6c717a, #c9cdd3 35%, #eef0f2 50%, #9ca1a9 75%, #5c6168); box-shadow: inset 0 .15cqw 0 rgba(255,255,255,.8), 0 .8cqw 1.2cqw -.3cqw rgba(0,0,0,.6); }
