---
// Imported from yk-site/objects/behalve by scripts/import-object.py; edit there and re-import.
---
<div class="obj-behalve">
      <button class="bv-hit" type="button" aria-label="Ring the front-desk bell. A customer asks to book and Behalve replies with a time.">
        <span class="bv-floor" aria-hidden="true"></span>
        <span class="bv-top" aria-hidden="true"></span>
        <span class="bv-phone" aria-hidden="true">
          <span class="bv-screen">
            <span class="bv-head">Behalve<b></b></span>
            <span class="bv-thread"></span>
            <span class="bv-dim"></span>
          </span>
          <span class="bv-island"></span>
          <span class="bv-glare"></span>
        </span>
        <span class="bv-stand" aria-hidden="true"></span>
        <span class="bv-front" aria-hidden="true"></span>
        <span class="bv-badge" aria-hidden="true">Behalve <i>·</i> here to help</span>
        <span class="bv-bell" aria-hidden="true">
          <span class="bv-bshadow"></span>
          <span class="bv-base"></span>
          <span class="bv-waves"><i></i><i></i><i></i></span>
          <span class="bv-domewrap">
            <span class="bv-plunger"><span class="bv-rod"></span><span class="bv-knob"></span></span>
            <span class="bv-dome"></span>
            <span class="bv-rim"></span>
          </span>
        </span>
      </button>
    </div>

<style is:inline>
.obj-behalve { position: relative; width: min(256px, 76%); container-type: inline-size; }
.obj-behalve .bv-hit { all: unset; display: block; position: relative; width: 100%; aspect-ratio: 100 / 88; cursor: pointer; -webkit-tap-highlight-color: transparent; border-radius: 4cqw; }
.obj-behalve .bv-hit:focus-visible { outline: 2px solid var(--ink-3); outline-offset: 3cqw; }
.obj-behalve .bv-hit span { display: block; position: absolute; }

/* ---------- counter ---------- */
.obj-behalve .bv-floor { left: 2cqw; right: 2cqw; bottom: 0; height: 8cqw; border-radius: 50%;
  background: radial-gradient(closest-side, rgba(0,0,0,.34), rgba(0,0,0,.14) 55%, transparent); filter: blur(1.4cqw); }
.obj-behalve .bv-top { left: 0; right: 0; bottom: 19.6cqw; height: 13cqw; border-radius: 3cqw 3cqw 0 0;
  clip-path: polygon(4.5% 0, 95.5% 0, 100% 100%, 0 100%);
  background:
    linear-gradient(180deg, rgba(0,0,0,.18), transparent 35%, rgba(255,230,190,.10) 92%, rgba(255,236,200,.35) 100%),
    repeating-linear-gradient(178deg, rgba(60,30,12,0) 0 1.1cqw, rgba(60,30,12,.16) 1.1cqw 1.3cqw, rgba(255,220,170,.05) 1.3cqw 2.2cqw),
    repeating-linear-gradient(181deg, rgba(40,20,8,.0) 0 2.9cqw, rgba(40,20,8,.14) 2.9cqw 3.1cqw),
    radial-gradient(60% 120% at 30% 40%, #9a6a42, transparent 70%),
    linear-gradient(90deg, #7a4f30, #8d5e39 40%, #80532f 75%, #6d4528); }
.obj-behalve .bv-front { left: 0; right: 0; bottom: 4cqw; height: 16cqw; border-radius: 0 0 2.6cqw 2.6cqw;
  background:
    linear-gradient(180deg, rgba(255,226,180,.38) 0, rgba(255,226,180,.08) .5cqw, transparent 1.2cqw, transparent 70%, rgba(0,0,0,.28)),
    repeating-linear-gradient(179.3deg, rgba(40,18,6,0) 0 1.7cqw, rgba(40,18,6,.16) 1.7cqw 1.9cqw, rgba(255,215,160,.04) 1.9cqw 3.1cqw),
    repeating-linear-gradient(180.6deg, rgba(40,18,6,0) 0 .9cqw, rgba(40,18,6,.09) .9cqw 1cqw),
    radial-gradient(14% 40% at 24% 60%, rgba(30,12,4,.22), transparent 70%),
    radial-gradient(30% 90% at 72% 50%, rgba(40,18,6,.18), transparent 70%),
    linear-gradient(90deg, #4f301b, #613b21 30%, #5a361e 60%, #472a17);
  box-shadow: inset 0 -.5cqw .8cqw rgba(0,0,0,.25); }

/* enamel name badge */
.obj-behalve .bv-badge { left: 50%; bottom: 9cqw; transform: translateX(-50%); padding: .9cqw 3.2cqw 1cqw; border-radius: 99px; white-space: nowrap;
  background: linear-gradient(180deg, #fbf6ea, #ece3cf); color: #3b2a1a;
  font: 600 2.75cqw/1 var(--f-sans); letter-spacing: .02em;
  box-shadow: 0 0 0 .55cqw #b98d3e, 0 0 0 .75cqw #6e4f1c, 0 .5cqw .7cqw .6cqw rgba(0,0,0,.35), inset 0 .3cqw .3cqw rgba(255,255,255,.8), inset 0 -.3cqw .4cqw rgba(120,90,40,.18); }
.obj-behalve .bv-badge i { font-style: normal; font-weight: 400; color: #8a7559; }
.obj-behalve .bv-badge::before, .obj-behalve .bv-badge::after { content: ""; position: absolute; top: 50%; width: 1.1cqw; height: 1.1cqw; margin-top: -.55cqw; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #f5df9f, #a37a2f 60%, #5b4115); }
.obj-behalve .bv-badge::before { left: -4.2cqw; } .obj-behalve .bv-badge::after { right: -4.2cqw; }

/* ---------- phone on a stand ---------- */
.obj-behalve .bv-phone { right: 10cqw; bottom: 26cqw; width: 31cqw; height: 58cqw; border-radius: 4.6cqw;
  background: linear-gradient(135deg, #3a3a3c, #18181a 45%, #232325);
  box-shadow: inset 0 0 0 .35cqw #4a4a4d, inset 0 0 0 .6cqw #0c0c0d, 1.2cqw 2cqw 2.4cqw rgba(0,0,0,.35), .3cqw .6cqw .6cqw rgba(0,0,0,.3); }
.obj-behalve .bv-screen { inset: 1.5cqw; border-radius: 3.3cqw; overflow: hidden; background: #f6f2ea; }
.obj-behalve .bv-head { left: 0; right: 0; top: 0; height: 9cqw; padding: 3.6cqw 0 0 2.4cqw; background: #efe9dd; border-bottom: .2cqw solid rgba(60,40,20,.08);
  font: 600 2.3cqw/1 var(--f-sans); color: #3b2a1a; }
.obj-behalve .bv-head::before { content: ""; display: inline-block; vertical-align: -.5cqw; width: 2.4cqw; height: 2.4cqw; margin-right: 1cqw; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #f3dc98, #b8893a 60%, #6d4e1b); }
.obj-behalve .bv-head b { display: inline-block; vertical-align: .1cqw; width: 1.2cqw; height: 1.2cqw; margin-left: 1cqw; border-radius: 50%; background: #4f9a6e; box-shadow: 0 0 0 .3cqw rgba(79,154,110,.2); }
.obj-behalve .bv-island { left: 50%; top: 1.3cqw; width: 8cqw; height: 1.9cqw; margin-left: -4cqw; border-radius: 99px; background: #111; z-index: 2; }
.obj-behalve .bv-thread { left: 0; right: 0; top: 9cqw; bottom: 5.4cqw; padding: 0 1.7cqw; display: flex !important; flex-direction: column; justify-content: flex-end; gap: 1.2cqw; overflow: hidden; }
.obj-behalve .bv-thread span.bv-msg { position: relative; max-width: 86%; padding: 1.3cqw 1.9cqw 1.4cqw; border-radius: 2.6cqw; font: 500 2.2cqw/1.3 var(--f-sans);
  transform-origin: 0 100%; animation: obj-behalve-pop .42s var(--ease-out) both; flex: none; }
.obj-behalve .bv-thread span.bv-in { align-self: flex-start; background: #e6dfd1; color: #2d241b; border-bottom-left-radius: .8cqw; }
.obj-behalve .bv-thread span.bv-out { align-self: flex-end; background: #2f5a4a; color: #f4efe4; border-bottom-right-radius: .8cqw; transform-origin: 100% 100%; }
.obj-behalve .bv-thread span.bv-typing { padding: 1.6cqw 2cqw; }
.obj-behalve .bv-typing i { display: inline-block; width: 1cqw; height: 1cqw; margin: 0 .25cqw; border-radius: 50%; background: #f4efe4; opacity: .4; animation: obj-behalve-dot 1s ease-in-out infinite; }
.obj-behalve .bv-typing i:nth-child(2) { animation-delay: .15s; } .obj-behalve .bv-typing i:nth-child(3) { animation-delay: .3s; }
.obj-behalve .bv-thread span.bv-msg.bv-still { animation: none; }
.obj-behalve .bv-thread span.bv-msg.bv-gone { animation: obj-behalve-out .35s ease-in both; }
.obj-behalve .bv-dim { inset: 0; background: #0d0d0e; opacity: 0; transition: opacity .9s ease; pointer-events: none; z-index: 3; }
.obj-behalve.is-asleep .bv-dim { opacity: .82; }
.obj-behalve .bv-glare { inset: 0; border-radius: 3.3cqw; z-index: 4; pointer-events: none;
  background: linear-gradient(115deg, rgba(255,255,255,.16) 0 22%, transparent 22.5%); }
.obj-behalve .bv-stand { right: 14cqw; bottom: 24cqw; width: 23cqw; height: 6cqw; border-radius: 1.2cqw 1.2cqw .8cqw .8cqw;
  background: linear-gradient(180deg, #a77b4f, #8a6038 40%, #6f4a2a);
  box-shadow: 0 1.2cqw 1.4cqw -.4cqw rgba(0,0,0,.45), inset 0 .3cqw 0 rgba(255,230,190,.35); }

/* ---------- brass service bell ---------- */
.obj-behalve .bv-bell { left: 10cqw; bottom: 21cqw; width: 36cqw; height: 33cqw; }
.obj-behalve .bv-bshadow { left: -2cqw; right: -2cqw; bottom: -1.6cqw; height: 6cqw; border-radius: 50%; background: radial-gradient(closest-side, rgba(20,8,0,.55), rgba(20,8,0,.2) 60%, transparent); filter: blur(.6cqw); }
.obj-behalve .bv-base { left: 1cqw; right: 1cqw; bottom: 0; height: 7cqw; border-radius: 0 0 50% 50% / 0 0 2.6cqw 2.6cqw;
  background: linear-gradient(90deg, #0d0b0a, #2c2623 18%, #4a413b 30%, #221d1a 48%, #141110 75%, #0a0807);
  box-shadow: inset 0 -.3cqw .2cqw rgba(255,255,255,.06); }
.obj-behalve .bv-base::after { content: ""; position: absolute; left: 0; right: 0; top: -2.2cqw; height: 4.6cqw; border-radius: 50%;
  background: radial-gradient(70% 80% at 40% 40%, #2f2925, #161311 70%); box-shadow: inset 0 .3cqw .2cqw rgba(255,255,255,.14), inset 0 -.2cqw .2cqw rgba(0,0,0,.6); }
.obj-behalve .bv-domewrap { left: 4cqw; right: 4cqw; bottom: 5.4cqw; height: 22cqw; transform-origin: 50% 100%; }
.obj-behalve .bv-dome { left: 0; right: 0; bottom: 0; height: 17cqw; border-radius: 50% 50% 46% 46% / 100% 100% 18% 18%;
  background:
    radial-gradient(28% 34% at 34% 26%, rgba(255,248,215,.95), rgba(255,240,190,.35) 45%, transparent 75%),
    radial-gradient(70% 60% at 70% 80%, rgba(70,40,5,.45), transparent 70%),
    linear-gradient(90deg, #5a3f14 0%, #9b7330 14%, #e6c675 30%, #f7e3a4 38%, #c99c47 52%, #a67a2e 68%, #6d4d18 88%, #4c3510 100%);
  box-shadow: inset 0 -.8cqw 1cqw rgba(60,35,5,.5), inset 0 .3cqw .4cqw rgba(255,240,200,.4); }
.obj-behalve .bv-dome::after { content: ""; position: absolute; left: 58%; top: 18%; width: 9%; height: 46%; border-radius: 50%; background: linear-gradient(180deg, rgba(255,245,210,.55), transparent); transform: rotate(18deg); filter: blur(.25cqw); }
.obj-behalve .bv-rim { left: -.6cqw; right: -.6cqw; bottom: -1cqw; height: 3.4cqw; border-radius: 50%;
  background: linear-gradient(90deg, #4c3510, #b48a3e 25%, #f1d991 40%, #b8893a 60%, #6d4d18 85%, #3e2b0c);
  box-shadow: 0 .3cqw .4cqw rgba(0,0,0,.45), inset 0 .35cqw .2cqw rgba(255,240,200,.45); }
.obj-behalve .bv-plunger { left: 50%; bottom: 16.2cqw; width: 6.4cqw; height: 6.8cqw; margin-left: -3.2cqw; transition: transform .5s var(--ease-out); }
.obj-behalve .bv-rod { left: 50%; bottom: 0; width: 1.5cqw; height: 4.4cqw; margin-left: -.75cqw; border-radius: .3cqw;
  background: linear-gradient(90deg, #5c4214, #e8cc80 45%, #8e6826); }
.obj-behalve .bv-knob { left: 0; right: 0; top: 0; height: 3.6cqw; border-radius: 50%;
  background: radial-gradient(60% 70% at 38% 30%, #fff1c4, #d4ab5a 45%, #7d5a1f 90%);
  box-shadow: 0 .3cqw .3cqw rgba(40,20,0,.45); }
.obj-behalve .bv-hit:hover .bv-plunger { transform: translateY(-.5cqw); }
.obj-behalve.is-ring .bv-plunger { animation: obj-behalve-press .5s var(--ease-out) both; }
.obj-behalve.is-ring .bv-domewrap { animation: obj-behalve-wobble .9s ease-out both; }

/* ring waves */
.obj-behalve .bv-waves { left: 50%; bottom: 31cqw; width: 0; height: 0; }
.obj-behalve .bv-waves i { position: absolute; left: -10cqw; top: -7cqw; width: 20cqw; height: 14cqw; border-radius: 50%; border: .55cqw solid transparent; border-top-color: #c79c46; opacity: 0; }
.obj-behalve.is-ring .bv-waves i { animation: obj-behalve-wave 1.1s cubic-bezier(.2,.7,.3,1) both; }
.obj-behalve.is-ring .bv-waves i:nth-child(2) { animation-delay: .14s; }
.obj-behalve.is-ring .bv-waves i:nth-child(3) { animation-delay: .28s; }

/* phone buzz */
.obj-behalve.is-buzz .bv-phone { animation: obj-behalve-buzz .36s linear both; }

.obj-behalve.is-paused *, .obj-behalve.is-paused *::before, .obj-behalve.is-paused *::after { animation-play-state: paused !important; }

@keyframes obj-behalve-pop { from { opacity: 0; transform: translateY(1.2cqw) scale(.82); } to { opacity: 1; transform: none; } }
@keyframes obj-behalve-out { to { opacity: 0; transform: translateY(-1cqw) scale(.96); } }
@keyframes obj-behalve-dot { 0%, 100% { opacity: .35; transform: none; } 50% { opacity: 1; transform: translateY(-.35cqw); } }
@keyframes obj-behalve-press { 0% { transform: none; } 22% { transform: translateY(1.9cqw); } 100% { transform: none; } }
@keyframes obj-behalve-wobble { 0%, 18% { transform: none; } 30% { transform: rotate(-1.1deg) scaleY(.985); } 46% { transform: rotate(.8deg); } 62% { transform: rotate(-.45deg); } 80% { transform: rotate(.2deg); } 100% { transform: none; } }
@keyframes obj-behalve-wave { 0% { opacity: 0; transform: translateY(0) scale(.45); } 18% { opacity: .9; } 100% { opacity: 0; transform: translateY(-5cqw) scale(1.35); } }
@keyframes obj-behalve-buzz { 0%, 100% { transform: none; } 20% { transform: translateX(-.4cqw) rotate(-.6deg); } 40% { transform: translateX(.4cqw) rotate(.6deg); } 60% { transform: translateX(-.3cqw); } 80% { transform: translateX(.2cqw); } }

@media (prefers-reduced-motion: reduce) {
  .obj-behalve *, .obj-behalve *::before, .obj-behalve *::after { animation: none !important; transition: none !important; }
}
</style>

<script is:inline>
(function () {
  var roots = document.querySelectorAll('.obj-behalve');
  if (!roots.length) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var audio = null;

  var IDLE = [
    ['Are you open Sunday?', 'Yes, 9 till 2.'],
    ['Running 10 min late, sorry!', 'No worries, see you soon.'],
    ['Can I bring my dog?', 'Of course, she’s welcome.'],
    ['Do you do gift cards?', 'We do. Any amount you like.']
  ];
  var BOOK = [
    ['in', 'Hi! Can I book a trim on Saturday?'],
    ['out', 'Sure! 10:30 or 2:00?'],
    ['in', '10:30 please'],
    ['out', 'Booked for Sat 10:30 ✓']
  ];

  function ding() {
    try {
      var AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      audio = audio || new AC();
      if (audio.state === 'suspended') audio.resume();
      var t = audio.currentTime, out = audio.createGain();
      out.gain.setValueAtTime(0.0001, t);
      out.gain.exponentialRampToValueAtTime(0.05, t + 0.005);
      out.gain.exponentialRampToValueAtTime(0.0001, t + 1.6);
      out.connect(audio.destination);
      [[2093, 1], [5230, 0.35], [3140, 0.2]].forEach(function (p) {
        var o = audio.createOscillator(), g = audio.createGain();
        o.type = 'sine'; o.frequency.value = p[0]; g.gain.value = p[1];
        o.connect(g); g.connect(out); o.start(t); o.stop(t + 1.7);
      });
    } catch (e) {}
  }

  function init(root) {
    var btn = root.querySelector('.bv-hit');
    var thread = root.querySelector('.bv-thread');
    if (!btn || !thread) return;
    var visible = false, hidden = document.hidden, active = false;
    var steps = [], idx = 0, timer = null, due = 0, left = 0, idleN = 0;

    // tiny pausable step runner: each step waits d ms then runs fn
    function run(list) { clearTimeout(timer); timer = null; steps = list; idx = 0; left = steps.length ? steps[0][0] : 0; next(); }
    function next() {
      if (idx >= steps.length || !active) return;
      due = Date.now() + left;
      timer = setTimeout(function () {
        timer = null;
        var fn = steps[idx][1]; idx++;
        left = idx < steps.length ? steps[idx][0] : 0;
        fn(); next();
      }, left);
    }
    function pause() { if (timer) { clearTimeout(timer); timer = null; left = Math.max(0, due - Date.now()); } }

    function setActive() {
      var a = visible && !hidden;
      if (a === active) return;
      active = a;
      root.classList.toggle('is-paused', !a);
      if (a) { if (!reduce) { if (idx >= steps.length && !timer) idle(!idleN); else next(); } }
      else pause();
    }

    function bubble(kind, text) {
      var s = document.createElement('span');
      s.className = 'bv-msg bv-' + kind;
      s.textContent = text;
      thread.appendChild(s);
      while (thread.children.length > 6) thread.removeChild(thread.firstChild);
      return s;
    }
    function typing() {
      var s = bubble('out', '');
      s.classList.add('bv-typing');
      s.innerHTML = '<i></i><i></i><i></i>';
      return s;
    }
    function untype() { var t = thread.querySelector('.bv-typing'); if (t) t.remove(); }
    function clear() { Array.prototype.forEach.call(thread.children, function (c) { c.classList.add('bv-gone'); }); }
    function wipe() { thread.textContent = ''; }
    function wake() { root.classList.remove('is-asleep'); }
    function sleep() { root.classList.add('is-asleep'); }
    function buzz() {
      root.classList.remove('is-buzz'); void root.offsetWidth; root.classList.add('is-buzz');
    }

    function idle(first) {
      var pair = IDLE[idleN++ % IDLE.length];
      run([
        [first ? 3400 : 700, function () { clear(); }],
        [380, function () { wipe(); wake(); buzz(); bubble('in', pair[0]); }],
        [900, function () { typing(); }],
        [1300, function () { untype(); bubble('out', pair[1]); }],
        [2600, function () { sleep(); }],
        [3200, function () { idle(); }]
      ]);
    }

    function ring() {
      root.classList.remove('is-ring'); void root.offsetWidth; root.classList.add('is-ring');
      ding();
      if (reduce) {
        wipe(); wake();
        BOOK.forEach(function (m) { bubble(m[0], m[1]); });
        return;
      }
      var list = [
        [120, function () { clear(); }],
        [300, function () { wipe(); wake(); buzz(); bubble('in', BOOK[0][1]); }],
        [700, function () { typing(); }],
        [1000, function () { untype(); bubble('out', BOOK[1][1]); }],
        [1100, function () { buzz(); bubble('in', BOOK[2][1]); }],
        [600, function () { typing(); }],
        [1000, function () { untype(); bubble('out', BOOK[3][1]); }],
        [4200, function () { sleep(); }],
        [3000, function () { idle(); }]
      ];
      run(list);
      if (!active) pause();
    }

    btn.addEventListener('click', ring);
    root.addEventListener('animationend', function (e) {
      if (e.animationName === 'obj-behalve-wave' && e.target === root.querySelector('.bv-waves i:last-child')) root.classList.remove('is-ring');
      if (e.animationName === 'obj-behalve-buzz') root.classList.remove('is-buzz');
    });

    // resting state: one finished exchange on a lit screen
    bubble('in', IDLE[3][0]).classList.add('bv-still'); bubble('out', IDLE[3][1]).classList.add('bv-still');
    if (reduce) return;

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; setActive(); }, { threshold: 0.15 }).observe(root);
    } else { visible = true; setActive(); }
    document.addEventListener('visibilitychange', function () { hidden = document.hidden; setActive(); });
  }

  Array.prototype.forEach.call(roots, init);
})();
</script>
