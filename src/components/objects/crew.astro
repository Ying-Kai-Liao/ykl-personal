  box-shadow: 0 0 0 .75cqw #8d929a, 0 0 0 .95cqw rgba(0,0,0,.25), inset 0 -.4cqw .6cqw rgba(0,0,0,.5); }
.obj-crew .oc-lamp.is-lit { background: radial-gradient(circle at 37% 30%, #fff 0 10%, #c4ffd8 22%, #46d985 50%, #13894a 92%); box-shadow: 0 0 0 .75cqw #8d929a, 0 0 0 .95cqw rgba(0,0,0,.25), 0 0 3cqw .8cqw rgba(70,225,135,.55); }
.obj-crew .oc-count { position: absolute; right: 3.2cqw; top: 9cqw; padding: .9cqw 1.1cqw .8cqw 1.4cqw; border-radius: .8cqw; background: linear-gradient(#111316, #22252a); box-shadow: inset 0 .35cqw .45cqw rgba(0,0,0,.8), 0 .2cqw 0 rgba(255,255,255,.7); font: 500 3.1cqw/1 var(--f-mono); letter-spacing: .16em; color: #efe5cc; overflow: hidden; }
.obj-crew .oc-count span { transition: transform .3s var(--ease-out); }
.obj-crew .oc-count.is-tick span { transform: translateY(-30%); transition: none; }
.obj-crew .oc-box-label { position: absolute; right: 3.2cqw; top: 16.2cqw; font: 500 1.9cqw/1 var(--f-mono); letter-spacing: .2em; text-transform: uppercase; color: #6a7079; text-shadow: 0 .15cqw 0 rgba(255,255,255,.65); }

.obj-crew .oc-stamp { position: absolute; left: 71.5cqw; top: 3.4cqw; width: 13cqw; height: 16cqw; z-index: 40; filter: drop-shadow(0 .9cqw .8cqw rgba(0,0,0,.5)); transition: transform .4s var(--ease-out); }
.obj-crew .oc-knob { position: absolute; left: 3cqw; top: 0; width: 7cqw; height: 6cqw; border-radius: 50%; background: radial-gradient(circle at 36% 28%, #c58f62 0 8%, #7b5235 30%, #3b2618 72%, #24160d); }
.obj-crew .oc-neck { position: absolute; left: 5cqw; top: 4.8cqw; width: 3cqw; height: 4.2cqw; background: linear-gradient(90deg, #26180e, #75523a 40%, #2a1b11); }
.obj-crew .oc-block { position: absolute; left: 0; top: 8.6cqw; width: 13cqw; height: 5.6cqw; border-radius: .9cqw .9cqw .4cqw .4cqw;
  background: linear-gradient(90deg, rgba(0,0,0,.28), rgba(255,255,255,.14) 30%, rgba(0,0,0,.22)), repeating-linear-gradient(90deg, rgba(60,30,10,.16) 0 .3cqw, transparent .3cqw 1.2cqw), linear-gradient(#b67f4f, #84552f); box-shadow: inset 0 .15cqw 0 rgba(255,230,200,.4); }
.obj-crew .oc-block::after { content: ""; position: absolute; left: 0; right: 0; top: 3.6cqw; height: 1.1cqw; background: linear-gradient(#f6dfa6, #bb8f45 55%, #7a5822); }
.obj-crew .oc-rubber { position: absolute; left: .6cqw; top: 14.2cqw; width: 11.8cqw; height: 1.6cqw; border-radius: 0 0 .5cqw .5cqw; background: linear-gradient(#2a2a2a, #1d5d3d); }
@media (hover: hover) { .obj-crew:hover .oc-stamp { transform: translateY(-.9cqw); } }
.obj-crew.is-press .oc-stamp { transform: translateY(25.6cqw); transition: transform .2s cubic-bezier(.6,0,.9,.5); }

.obj-crew .oc-dial { position: absolute; left: 6.5cqw; top: 66cqw; width: 23cqw; height: 23cqw; border-radius: 50%;
  background: conic-gradient(from 210deg, #f8e4ad, #b3843a, #f1d48e, #84601f, #e7c77d, #f8e4ad);
  box-shadow: inset 0 0 0 .2cqw rgba(255,255,255,.3), 0 .35cqw .5cqw rgba(0,0,0,.5), 0 1.6cqw 2.2cqw -.8cqw rgba(0,0,0,.55); }
.obj-crew .oc-face { position: absolute; inset: 1.7cqw; border-radius: 50%; overflow: hidden;
  background:
    radial-gradient(circle at 72% 70%, rgba(255,250,235,.9) 0 .14cqw, transparent .32cqw),
    radial-gradient(circle at 30% 68%, rgba(255,250,235,.7) 0 .12cqw, transparent .28cqw),
    radial-gradient(circle at 80% 32%, rgba(255,250,235,.8) 0 .13cqw, transparent .3cqw),
    radial-gradient(circle at 58% 18%, rgba(255,250,235,.6) 0 .1cqw, transparent .26cqw),
    radial-gradient(circle at 50% 38%, #26324d, #0d1220 78%);
  box-shadow: inset 0 .6cqw 1.1cqw rgba(0,0,0,.75); }
.obj-crew .oc-ticks { position: absolute; inset: 0; border-radius: 50%; background: repeating-conic-gradient(rgba(240,226,192,.6) 0 1.6deg, transparent 1.6deg 30deg);
  -webkit-mask-image: radial-gradient(circle, transparent 0 74%, #000 75% 88%, transparent 89%); mask-image: radial-gradient(circle, transparent 0 74%, #000 75% 88%, transparent 89%); }
.obj-crew .oc-moon { position: absolute; left: 16%; top: 17%; width: 5.4cqw; height: 5.4cqw; border-radius: 50%; box-shadow: inset -1.5cqw .6cqw 0 0 #f1e3ba; filter: drop-shadow(0 0 .9cqw rgba(241,227,186,.45)); transform: rotate(-20deg); }
.obj-crew .oc-hand { position: absolute; left: 50%; bottom: 50%; border-radius: 1cqw; transform-origin: 50% 100%; background: #f1e6c9; box-shadow: 0 .25cqw .3cqw rgba(0,0,0,.6); transition: transform 1.2s var(--ease-out); }
.obj-crew .oc-hand.h { width: .9cqw; height: 5cqw; margin-left: -.45cqw; }
.obj-crew .oc-hand.m { width: .6cqw; height: 7.4cqw; margin-left: -.3cqw; }
